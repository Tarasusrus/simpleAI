SYS_PROMPT=ты добродушный агент готовый выполнять просьбу из телеграм чата

# --- LLM провайдеры ---

# Основной: DeepSeek (https://platform.deepseek.com)
DEEPSEEK_API_KEY=your_deepseek_api_key

# Фолбек + эмбеддинги: Gemini (https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key

LLM_PROVIDER=openai
LLM_BASE_URL=https://api.deepseek.com/v1
# Имя модели также используется как model в Langfuse generation —
# должно совпадать с записью модели в Langfuse settings (для матчинга pricing/cost).
# Дашборд DeepSeek может показывать display name (например 'deepseek-v4-flash')
# даже если API принимает 'deepseek-chat' как алиас.
LLM_CHAT_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=30
LLM_RETRY_COUNT=2
LLM_RETRY_BASE_MS=500
LLM_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_FALLBACK_MODEL=gemini-2.0-flash

EMBEDDING_MODEL=text-embedding-004

# --- База данных ---
POSTGRES_DB=simpleai
POSTGRES_USER=simpleai
POSTGRES_PASSWORD=simpleai
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_CHATS=
TELEGRAM_WORKERS=4
TELEGRAM_RATE_LIMIT_MS=0
TELEGRAM_MEDIA_DIR=data/telegram

# --- Mail worker ---
MAIL_ACCOUNTS_JSON=[]

# --- Логирование ---
LOG_LEVEL=info
LOG_FORMAT=json

# --- Observability (Langfuse self-hosted) ---
# Поднять: cd deploy/langfuse && docker compose --env-file .env up -d
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=pk-lf-rag-mm-dr-local
LANGFUSE_SECRET_KEY=sk-lf-rag-mm-dr-local-CHANGEME

# --- Локальная разработка (Ollama) ---
# Чтобы использовать Ollama локально: LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
OLLAMA_EMBED_MODEL=
OLLAMA_FALLBACK_MODEL=deepseek-r1:7b
