API_KEY=openapikey

SYS_PROMPT=preprompt

POSTGRES_DB=simpleai
POSTGRES_USER=simpleai
POSTGRES_PASSWORD=simpleai
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

EMBEDDING_MODEL=text-embedding-3-small

# LLM request timeout in seconds
LLM_PROVIDER=openai
LLM_CHAT_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=30
LLM_RETRY_COUNT=2
LLM_RETRY_BASE_MS=500

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_EMBED_MODEL=

# Mail worker (JSON array of accounts)
MAIL_ACCOUNTS_JSON=[]

# Telegram notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=

# Telegram bot access (comma-separated chat IDs; empty = allow all)
TELEGRAM_ALLOWED_CHATS=

# Telegram bot worker count
TELEGRAM_WORKERS=4

# Minimum interval between messages per chat in milliseconds (0 = disabled)
TELEGRAM_RATE_LIMIT_MS=0

# Where to store incoming media (photos/files)
TELEGRAM_MEDIA_DIR=data/telegram

# Optional: run mail worker once (set to 1/true)
MAIL_RUN_ONCE=0

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
