# Экран плана окна по HTTPS. Рендерится deploy/plan-nginx-install.sh: токен приложения
# подставляется на сервере из .env и в репозиторий не попадает.
# 443 занят 3x-ui, поэтому порт 8443; сертификат тот же, что у vpn.mcpgate.org.
limit_req_zone $binary_remote_addr zone=plan_login:1m rate=30r/m;

server {
    listen 8443 ssl;
    server_name vpn.mcpgate.org;

    ssl_certificate /etc/letsencrypt/live/vpn.mcpgate.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/vpn.mcpgate.org/privkey.pem;

    auth_basic "План окна";
    auth_basic_user_file /etc/nginx/plan.htpasswd;
    limit_req zone=plan_login burst=20 nodelay;

    location / {
        proxy_pass http://127.0.0.1:8090;
        # Приложение сверяет Host с loopback-списком и ждёт свой токен.
        proxy_set_header Host 127.0.0.1;
        proxy_set_header Authorization "Bearer __PLAN_WEB_TOKEN__";
        proxy_set_header X-Forwarded-For "";
    }
}
