# --- Langfuse self-hosted (dev defaults) ---
# Скопируй в .env и при необходимости подправь секреты.
# Все CHANGEME — для prod обязательно регенерировать.

# Web
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=CHANGEME_nextauth_secret              # openssl rand -base64 32
SALT=CHANGEME_salt                                     # openssl rand -hex 16
ENCRYPTION_KEY=CHANGEME_encryption_key                 # openssl rand -hex 32
TELEMETRY_ENABLED=false

# Postgres (langfuse own — порт хоста 5433, чтобы не конфликтовать с simpleai-postgres)
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/postgres

# Clickhouse
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=clickhouse

# Redis
REDIS_AUTH=CHANGEME_redis_password

# MinIO (S3 для blob storage)
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=CHANGEME_minio_password

# --- Seed: проект rag-mm + admin user (создаются при первом старте web) ---
LANGFUSE_INIT_ORG_ID=simpleai
LANGFUSE_INIT_ORG_NAME=simpleAI
LANGFUSE_INIT_PROJECT_ID=rag-mm
LANGFUSE_INIT_PROJECT_NAME=rag-mm
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-rag-mm-dr-local
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-rag-mm-dr-local-CHANGEME
LANGFUSE_INIT_USER_EMAIL=admin@local.dev
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=CHANGEME_admin_password
